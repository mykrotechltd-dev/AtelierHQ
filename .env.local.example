# Supabase (per-environment — one Supabase project can serve all tenants; isolation is via RLS, not separate projects)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# Service-role key — SERVER ONLY. Never import in a Client Component or expose via NEXT_PUBLIC_*.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Billing (Stripe) — subscriptions per tenant for commercialization
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PRICE_STARTER=price_...
NEXT_PUBLIC_STRIPE_PRICE_PRO=price_...

# WhatsApp Business Cloud API (Meta) — invoice + status notifications
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=

# AI Assistant
ANTHROPIC_API_KEY=sk-ant-...

# Email/SMS fallback
RESEND_API_KEY=
