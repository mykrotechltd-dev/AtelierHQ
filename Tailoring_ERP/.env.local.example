# Supabase
VITE_SUPABASE_URL=https://xxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...

# Server-only — used by migration/setup scripts. Never expose via VITE_ prefix
# (Vite only inlines VITE_-prefixed vars into the client bundle, so this is
# safe as long as it stays unprefixed).
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Set to "true" only on the dedicated admin-subdomain Vercel project
# (src/App.tsx). Leave unset everywhere else, including local dev — the
# default is the normal combined tenant + admin app.
VITE_ADMIN_ONLY=
